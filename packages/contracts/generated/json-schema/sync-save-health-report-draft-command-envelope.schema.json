        "language": {
          "enum": [
            "mr",
            "hi",
            "en"
          ],
          "type": "string"
        },
        "reportId": {
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string"
        },
        "schemaVersion": {
          "const": "health-report-draft-v1",
          "type": "string"
        },
        "symptomSummary": {
          "maxLength": 800,
          "minLength": 1,
          "type": "string"
        },
        "timezone": {
          "const": "Asia/Kolkata",
          "type": "string"
        }
      },
      "required": [
        "schemaVersion",
        "cropName",
        "language",
        "symptomSummary",
        "answers",
        "clientRecordedAt",
        "timezone"
