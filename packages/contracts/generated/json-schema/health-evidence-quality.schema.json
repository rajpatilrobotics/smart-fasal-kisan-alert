{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "limitations": {
      "items": {
        "maxLength": 220,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "type": "array"
    },
    "limitedPhotoCount": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "missingRequiredContext": {
      "items": {
        "enum": [
          "crop",
          "cropStage",
          "affectedPart",
          "symptomStarted",
          "spread",
          "areaAffected",
          "recentWeather",
          "recentInput",
          "farmerConcern"
        ],
        "type": "string"
      },
      "maxItems": 9,
      "type": "array"
    },
    "qualityBand": {
      "enum": [
        "USABLE",
        "LIMITED",
        "UNUSABLE"
      ],
      "type": "string"
    },
    "unusablePhotoCount": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "usablePhotoCount": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "validatorVersion": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "qualityBand",
    "usablePhotoCount",
    "limitedPhotoCount",
    "unusablePhotoCount",
    "missingRequiredContext",
    "limitations",
    "validatorVersion"
  ],
  "type": "object",
  "x-data-classification": "C3"
}
